{
  "name": "finance-dashboard",
  "version": "0.1.4",
  "private": true,
  "main": "desktop/main.cjs",
  "description": "A local-first household finance dashboard for Australia",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx server/src/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "build": "tsc -p server/tsconfig.json && vite build",
    "build:desktop": "npm run build && electron-rebuild --force --only better-sqlite3 && electron-builder --win nsis",
    "start": "node server/dist/index.js",
    "test": "tsx --test server/src/**/*.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "electron-updater": "^6.8.9",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  },
  "build": {
    "appId": "com.finance.dashboard",
    "productName": "Finance Dashboard",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "PumblerWork-web",
      "repo": "finance",
      "releaseType": "release"
    },
    "files": [
      "desktop/**/*",
      "dist/**/*",
      "server/dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
